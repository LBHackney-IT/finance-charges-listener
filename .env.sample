# Sample environment file.
#
# The function does **not** read `.env` itself. `docker compose` only interpolates the variables that
# docker-compose.yml references with `${...}` — for this repository that is `LBHPACKAGESTOKEN` (plus
# `SONAR_TOKEN` for the test image). The variables under "Runtime" below are read from the process
# environment and are **not** picked up from this file. In AWS they are supplied from SSM Parameter Store
# (see FinanceChargesListener/serverless.yml).

# --- Build (read from .env by docker compose) --------------------------------
# Personal access token with read:packages on the LBHackney-IT GitHub Packages feed.
# Required by `docker compose build` (the Hackney.* packages are not on nuget.org).
LBHPACKAGESTOKEN=your-github-personal-access-token-here

# --- Runtime (NOT read from .env — export these) ------------------------------
# docker compose already sets this on the container.
ENVIRONMENT=LocalDevelopment

# docker compose already sets these on the container (pointing at http://dynamodb-database:8000).
# Export them only when running the function outside Docker, against a local DynamoDB on port 8000.
DynamoDb_LocalMode=true
DynamoDb_LocalServiceUrl=http://localhost:8000

# AWS region and dummy credentials accepted by DynamoDB Local.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Spreadsheet input/output bucket and the SNS topic used for events and step chaining.
# Not supplied by docker compose — export them to exercise these flows locally.
CHARGES_BUCKET_NAME=lbh-charges-api-bucket-development
CHARGES_SNS_ARN=arn:aws:sns:eu-west-2:000000000000:charges-topic

# External APIs called by the charge use cases; each needs a base URL and a bearer token.
# Not supplied by docker compose — export them to exercise these flows locally.
HOUSING_SEARCH_API_URL=https://housing-search-api.example
HOUSING_SEARCH_API_TOKEN=
ASSET_INFORMATION_API_URL=https://asset-information-api.example
ASSET_INFORMATION_API_TOKEN=
FINANCIAL_SUMMARY_API_URL=https://financial-summary-api.example
FINANCIAL_SUMMARY_API_TOKEN=

# Header row written into the generated print-room CSV.
PRINT_RENT_STATEMENTS_HEADER=Rent statement header

# Note: PRINT_ROOM_BUCKET_NAME is declared in serverless.yml but is not read by the code.
